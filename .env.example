# Atelier Bureau — environment variables (copy to .env, never commit .env)
# Every value here is an example. Use sandbox/homologation credentials only.

# --- Database (MySQL 8, RNF16) ---------------------------------------
# App user: only SELECT, INSERT, UPDATE and DELETE (no DDL)
DATABASE_URL="mysql://atelier_app:CHANGE_ME@localhost:3306/atelier_bureau"
# Migration user: runs prisma migrate deploy (DDL allowed)
# The Prisma CLI only uses TLS with sslaccept, which the Docker MySQL
# requires (#221). The container certificate is self-signed
MIGRATION_DATABASE_URL="mysql://atelier_migrate:CHANGE_ME@localhost:3306/atelier_bureau?sslaccept=accept_invalid_certs"
# Shadow database of `prisma migrate dev` (development only). Needed
# with the Docker MySQL, whose migration user cannot create databases
SHADOW_DATABASE_URL="mysql://atelier_migrate:CHANGE_ME@localhost:3306/atelier_bureau_shadow?sslaccept=accept_invalid_certs"
# TLS of the app connection to MySQL (RNF16):
#   required (default) = encrypted, certificate not checked (works with the
#                        self-signed certificate of the MySQL container)
#   verify             = encrypted and checked against DATABASE_TLS_CA
#   disabled           = plain, only for a local MySQL without TLS
DATABASE_TLS="required"
# CA file for DATABASE_TLS=verify, e.g. a copy of ca.pem from the MySQL volume
DATABASE_TLS_CA=""

# --- Seed --------------------------------------------------------------
# Password of the fictitious seed accounts (development only)
SEED_PASSWORD=""

# --- Authentication (Better Auth) --------------------------------------
# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the store, e.g. https://192.168.0.50
BETTER_AUTH_URL="http://localhost:3000"

# --- Personal data encryption (RNF03) ----------------------------------
# 32 random bytes in base64, required in production: openssl rand -base64 32
# Keep a copy outside the server: without it the CPFs and phones are lost
DATA_ENCRYPTION_KEY=""

# --- Logs --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"

# --- Local server (docker compose, ARCHITECTURE.md 5.1) -----------------
# Hostname or fixed IP of the server machine on the LAN
SITE_HOST="192.168.0.50"
# LAN subnet allowed for the developer MySQL user (MySQL host pattern)
LAN_SUBNET="192.168.0.%"
# MySQL passwords (strong and different from each other)
MYSQL_ROOT_PASSWORD=""
MYSQL_APP_PASSWORD=""
MYSQL_MIGRATE_PASSWORD=""
MYSQL_BACKUP_PASSWORD=""
# Leave empty to disable remote developer access to MySQL
MYSQL_DEV_PASSWORD=""
# Address where port 3306 is published. 127.0.0.1 = this machine only;
# 0.0.0.0 opens MySQL to the LAN (with the firewall on the Private profile)
MYSQL_PUBLISH_ADDR="127.0.0.1"
# Backups: retention in days and UTC hour of the daily dump
BACKUP_RETENTION_DAYS="30"
BACKUP_HOUR="03"
# Optional push monitor of the uptime panel, called after each backup
# (#80), e.g. http://uptime-kuma:3001/api/push/<token>?status=up&msg=OK
# Empty = no push (docs/AtelierBureau_Monitoramento.md)
BACKUP_PUSH_URL=""
# Optional tunnel for the Mercado Pago webhook (docker compose --profile tunnel)
# Public hostname in the Cloudflare panel: http://webhook-gate:8080 (#57)
CLOUDFLARE_TUNNEL_TOKEN=""

# --- ViaCEP (public API, no key; RF22, RF38) ----------------------------
# Optional overrides. Default: https://viacep.com.br/ws and 3000 ms
VIACEP_BASE_URL=""
VIACEP_TIMEOUT_MS=""

# --- Uploaded files (product images, datasheets, attachments) ------------
# Default: ./storage/uploads (mounted as a volume in Docker)
STORAGE_DIR=""

# --- Background jobs (order expiration RN14) ------------------------------
# Set to "true" to stop the in-process jobs (e.g. a second app replica)
JOBS_DISABLED=""

# --- Transactional e-mail (RF53) -------------------------------------------
# Without SMTP_HOST, e-mails are written to ./storage/outbox (development).
# The queue (email_outbox) retries failed deliveries in the background.
SMTP_HOST=""
SMTP_PORT=""
# "true" for implicit TLS (port 465); STARTTLS is used otherwise
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# --- Correios API (PAC/SEDEX, #41, RF25, RN20) ------------------------------
# Homologation by default: https://apihom.correios.com.br
# Without user, access code and postage card, orders that fit the Correios
# limits fall back to the manual quote of the sales team (RN20).
CORREIOS_BASE_URL=""
CORREIOS_USER=""
CORREIOS_ACCESS_CODE=""
CORREIOS_POSTAGE_CARD=""
# Optional: contract prices
CORREIOS_CONTRACT=""
CORREIOS_REGIONAL_BOARD=""
# Optional: product codes of the contract. Default: PAC 03298, SEDEX 03220
CORREIOS_PAC_CODE=""
CORREIOS_SEDEX_CODE=""
# Optional: timeout per request in ms. Default: 5000
CORREIOS_TIMEOUT_MS=""

# --- Carrier aggregator (Melhor Envio sandbox, #42, RF49, RN20) -------------
# Sandbox by default: https://sandbox.melhorenvio.com.br
# Without the token, volumes above the Correios limits fall back to the
# manual quote of the sales team (RN20).
CARRIER_API_BASE_URL=""
CARRIER_API_TOKEN=""
# User-Agent required by the aggregator, e.g. "Atelier Bureau (contact address)"
CARRIER_API_USER_AGENT=""
# Optional: timeout in ms. Default: 8000
CARRIER_API_TIMEOUT_MS=""

# --- Mercado Pago (sandbox only, #54, RF28-RF37) ------------------------------
# Test credentials of the sandbox application (Mercado Pago developer panel).
# The access token stays on the server; the public key goes to the Brick.
# Without them, the payment page shows that online payment is unavailable.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Sandbox lock (#7): credentials that do not start with TEST- are refused
# (online payment stays off and the log says why) unless this is "true".
# Keep "false" on every dev, homologation and delivery server.
MERCADOPAGO_ALLOW_PRODUCTION="false"
# Optional overrides. Default: https://api.mercadopago.com and 10000 ms
MERCADOPAGO_BASE_URL=""
MERCADOPAGO_TIMEOUT_MS=""
# Public HTTPS address of the webhook (the tunnel), e.g.
# https://<tunnel-host>/api/webhooks/mercadopago. Empty = panel setting.
MERCADOPAGO_NOTIFICATION_URL=""
# Secret of the webhook signature (Mercado Pago panel, Webhooks, #57).
# Without it the webhook answers 503 and only the reconciliation runs.
MERCADOPAGO_WEBHOOK_SECRET=""

# --- NF-e provider (homologation only, #63, RF13) ---------------------------
# REST API of the NF-e provider (Focus NFe v2 contract), homologation by
# default: https://homologacao.focusnfe.com.br. The token is the
# homologation token of the issuer company. Without it the NF-e stays
# failed with an alert and is reprocessed once the token is set.
NFE_API_BASE_URL=""
NFE_API_TOKEN=""
# Optional: timeout in ms. Default: 15000
NFE_TIMEOUT_MS=""
