# Atelier Bureau — environment variables (copy to .env, never commit .env)
# Every value here is an example. Use sandbox/homologation credentials only.

# --- Database (MySQL 8, RNF16) ---------------------------------------
# App user: only SELECT, INSERT, UPDATE and DELETE (no DDL)
DATABASE_URL="mysql://atelier_app:CHANGE_ME@localhost:3306/atelier_bureau"
# Migration user: runs prisma migrate deploy (DDL allowed)
MIGRATION_DATABASE_URL="mysql://atelier_migrate:CHANGE_ME@localhost:3306/atelier_bureau"

# --- Seed --------------------------------------------------------------
# Password of the fictitious seed accounts (development only)
SEED_PASSWORD=""

# --- Authentication (Better Auth) --------------------------------------
# Random secret, at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the store, e.g. https://192.168.0.50
BETTER_AUTH_URL="http://localhost:3000"

# --- Logs --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"

# --- Local server (docker compose, ARCHITECTURE.md 5.1) -----------------
# Hostname or fixed IP of the server machine on the LAN
SITE_HOST="192.168.0.50"
# LAN subnet allowed for the developer MySQL user (MySQL host pattern)
LAN_SUBNET="192.168.0.%"
# MySQL passwords (strong and different from each other)
MYSQL_ROOT_PASSWORD=""
MYSQL_APP_PASSWORD=""
MYSQL_MIGRATE_PASSWORD=""
MYSQL_BACKUP_PASSWORD=""
# Leave empty to disable remote developer access to MySQL
MYSQL_DEV_PASSWORD=""
# Address where port 3306 is published. 127.0.0.1 = this machine only;
# 0.0.0.0 opens MySQL to the LAN (with the firewall on the Private profile)
MYSQL_PUBLISH_ADDR="127.0.0.1"
# Backups: retention in days and UTC hour of the daily dump
BACKUP_RETENTION_DAYS="30"
BACKUP_HOUR="03"
# Optional tunnel for the Mercado Pago webhook (docker compose --profile tunnel)
CLOUDFLARE_TUNNEL_TOKEN=""

# --- ViaCEP (public API, no key; RF22, RF38) ----------------------------
# Optional overrides. Default: https://viacep.com.br/ws and 3000 ms
VIACEP_BASE_URL=""
VIACEP_TIMEOUT_MS=""

# --- Uploaded files (product images, datasheets, attachments) ------------
# Default: ./storage/uploads (mounted as a volume in Docker)
STORAGE_DIR=""
