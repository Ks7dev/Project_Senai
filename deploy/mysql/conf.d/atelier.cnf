# MySQL 8.4 settings for Atelier Bureau (RNF16)
[mysqld]
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci
default-time-zone = '+00:00'
default-storage-engine = InnoDB
# TLS certificates are generated automatically by MySQL 8.
# Remote users are created with REQUIRE SSL (see init/01-users.sh).
tls_version = TLSv1.2,TLSv1.3
max_connections = 200
